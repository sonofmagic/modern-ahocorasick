{
  "name": "modern-ahocorasick-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "description": "modern-ahocorasick",
  "author": "SonOfMagic <qq1324318532@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/icelib/modern-ahocorasick#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/icelib/modern-ahocorasick.git"
  },
  "bugs": {
    "url": "https://github.com/icelib/modern-ahocorasick/issues"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . && pnpm lint:styles",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "vitest run",
    "test:dev": "vitest",
    "tsd": "turbo run tsd",
    "test:package": "node scripts/test-package.mjs",
    "prepare": "husky",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "format": "eslint . --fix",
    "validate": "pnpm build && pnpm lint && pnpm typecheck && pnpm tsd && pnpm test && pnpm test:package",
    "release": "pnpm change",
    "version-packages": "repo release stable prepare",
    "publish-packages": "repo release stable publish",
    "benchmark": "pnpm build && node --expose-gc scripts/benchmark.mjs",
    "docs:dev": "pnpm --filter modern-ahocorasick build && pnpm --filter @modern-ahocorasick/docs dev",
    "docs:build": "turbo run build --filter=@modern-ahocorasick/docs",
    "docs:preview": "pnpm --filter @modern-ahocorasick/docs preview",
    "test:docs:e2e": "pnpm docs:build && pnpm --filter @modern-ahocorasick/docs test:e2e",
    "lint:styles": "stylelint \"apps/docs/src/*.vue\" \"apps/docs/.vitepress/theme/*.css\"",
    "benchmark:docs": "pnpm --filter modern-ahocorasick build && node --expose-gc scripts/benchmark-docs.mjs",
    "docs:deploy": "pnpm docs:build && pnpm --filter @modern-ahocorasick/docs deploy",
    "docs:verify-deployment": "node scripts/verify-docs-deployment.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "~5.0.1",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "repoctl": "5.5.4",
    "stylelint": "^17.15.0",
    "tsd": "^0.33.0",
    "tsdown": "0.23.0",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "vitest": "~5.0.1"
  }
}
