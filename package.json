{
  "name": "modern-ahocorasick-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "description": "modern-ahocorasick",
  "author": "SonOfMagic <qq1324318532@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sonofmagic/modern-ahocorasick#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonofmagic/modern-ahocorasick.git"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/modern-ahocorasick/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "vitest run",
    "test:dev": "vitest",
    "tsd": "turbo run tsd",
    "test:package": "node scripts/test-package.mjs",
    "prepare": "husky",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "format": "eslint . --fix",
    "validate": "pnpm build && pnpm lint && pnpm typecheck && pnpm tsd && pnpm test && pnpm test:package",
    "release": "pnpm change",
    "version-packages": "repo release stable prepare",
    "publish-packages": "repo release stable publish"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "~5.0.1",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "repoctl": "5.5.4",
    "stylelint": "^17.15.0",
    "tsd": "^0.33.0",
    "tsdown": "0.23.0",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "vitest": "~5.0.1"
  }
}
