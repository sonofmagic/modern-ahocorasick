{
  "name": "modern-ahocorasick",
  "type": "module",
  "version": "3.0.0",
  "description": "Unicode-aware Aho–Corasick multi-pattern matching with UTF-16 ranges, counting, lazy iteration, and replacement.",
  "author": "SonOfMagic <qq1324318532@gmail.com>",
  "license": "MIT",
  "homepage": "https://aho.icebreaker.top/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icelib/modern-ahocorasick.git",
    "directory": "packages/modern-ahocorasick"
  },
  "bugs": {
    "url": "https://github.com/icelib/modern-ahocorasick/issues"
  },
  "keywords": [
    "ahocorasick",
    "aho-corasick",
    "multi-pattern-matching",
    "string-matching",
    "text-search",
    "unicode",
    "grapheme",
    "typescript"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": "./*",
    "./text": {
      "import": {
        "types": "./dist/text.d.ts",
        "default": "./dist/text.js"
      },
      "require": {
        "types": "./dist/text.d.cts",
        "default": "./dist/text.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "MIGRATION.md",
    "README.zh-CN.md",
    "UNICODE-LICENSE.txt",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "tsd": "tsd --files test-d/**/*.test-d.ts"
  }
}
