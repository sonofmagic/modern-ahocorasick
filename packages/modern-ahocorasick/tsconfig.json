{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "ES2022.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "vitest/globals"
    ],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src",
    "test",
    "*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
