{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "ES2022.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vitest/globals",
      "vitepress/client"
    ],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts",
    "*.ts",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".vitepress/dist",
    ".vitepress/cache"
  ]
}
